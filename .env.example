# ============================================================
# Neon Database
# Get this from: https://console.neon.tech (Connection Details)
# ============================================================
DATABASE_URL=postgresql://USER:PASSWORD@HOST.neon.tech/DBNAME?sslmode=require

# ============================================================
# Neon Auth (Better Auth)
# Enable Auth in your Neon project -> Auth tab -> Configuration
# Copy the "Auth URL" from Project Info
# Generate cookie secret with: openssl rand -base64 32
# ============================================================
NEON_AUTH_BASE_URL=https://ep-xxxxx.neonauth.us-east-1.aws.neon.tech/neondb/auth
NEON_AUTH_COOKIE_SECRET=your_32_char_or_longer_random_secret_here

# ============================================================
# Vercel Blob (File Storage)
# Create at: Vercel Dashboard -> Storage -> Blob
# ============================================================
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxxxxxxx

# ============================================================
# AI Services
# ============================================================
OPENROUTER_API_KEY=your_openrouter_key
NEXT_PUBLIC_GEMINI_API_KEY=your_gemini_key
